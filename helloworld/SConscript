# =============================================================================
# helloworld - triangle (OpenGL hello world). Setup + screen-stream smoke test.
# Produces build/linux/helloworld and build/windows/helloworld.exe.
# =============================================================================
Import("env_linux", "env_windows", "build_linux", "build_windows")

APP = "helloworld"
src = "main.cpp"

# --- Linux -------------------------------------------------------------------
if build_linux and env_linux is not None:
    e = env_linux.Clone()
    obj = e.Object(target="#build/linux/obj/%s/main.o" % APP, source=src)
    e.Program(
        target="#build/linux/%s" % APP,
        source=obj,
    )

# --- Windows (cross-compile) -------------------------------------------------
if build_windows and env_windows is not None:
    e = env_windows.Clone()
    obj = e.Object(target="#build/windows/obj/%s/main.o" % APP, source=src)
    e.Program(
        target="#build/windows/%s" % APP,  # PROGSUFFIX appends .exe
        source=obj,
    )
