{
  // OpenGL (GLFW + GLEW) development devcontainer on Debian 13 (trixie).
  // HOST: Windows 11 + WSL2. Runtime: Podman inside WSL2. GPU via /dev/dxg + WSLg.
  // For a native Linux host use ../linux/devcontainer.json (same Dockerfile).
  "name": "OpenGL dev (Windows / WSL)",

  // build.args make it easy to swap GLFW for a fork without editing the Dockerfile.
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "GLFW_REPO": "https://github.com/glfw/glfw.git",
      "GLFW_REF": "master"
    }
  },
	"features": {
		"ghcr.io/devcontainers/features/common-utils:1": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"upgradePackages": true
		}
	},
  // Container user = root (project requirement).
  "remoteUser": "root",
  "containerUser": "root",


  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // Real host GPU shared through the WSL compute layer (no dedicated passthrough,
  // no software render). Any GPU (NVIDIA/AMD/Intel, onboard/offboard).
  "runArgs": [
    "--device=/dev/dxg"
  ],

  // WSL libs (GPU loader) + WSLg sockets (display on Windows).
  "mounts": [
    "source=/usr/lib/wsl,target=/usr/lib/wsl,type=bind",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind",
    "source=/mnt/wslg/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:USERPROFILE}/.ssh/devcontainer-keys,target=/root/.ssh/,type=bind"
  ],

  // Display (WSLg) + path to the WSL GPU libs. GALLIUM_DRIVER makes Mesa use the
  // d3d12 driver (host GPU) instead of falling back to llvmpipe (software).
  "containerEnv": {
    "GALLIUM_DRIVER": "d3d12",
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "/mnt/wslg/PulseServer",
    "LD_LIBRARY_PATH": "/usr/lib/wsl/lib"
  },

  // /workspace only exists at runtime (bind mount), so the static libs staged in
  // the image (/opt/dependencies) are copied into the project after creation.
  "postCreateCommand": "rm -rf /workspace/dependencies/linux /workspace/dependencies/windows && mkdir -p /workspace/dependencies && cp -a /opt/dependencies/. /workspace/dependencies/",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  }
}
